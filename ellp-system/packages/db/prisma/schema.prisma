generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  admin
  professor
  tutor
  pendente
}

enum OficinaStatus {
  planejada
  em_andamento
  concluida
  cancelada
}

enum MatriculaStatus {
  ativa
  aprovado
  reprovado
  desistente
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(255)
  senha     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  userRole       UserRole?
  oficinas       Oficina[]      @relation("ProfessorOficinas")
  oficinaTutores OficinaTutor[]

  @@map("profiles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  role      AppRole  @default(professor)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

model Aluno {
  id             String    @id @default(uuid()) @db.Uuid
  nome           String    @db.VarChar(120)
  email          String?   @db.VarChar(255)
  telefone       String?   @db.VarChar(20)
  ra             String?   @db.VarChar(50)
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  observacoes    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  matriculas Matricula[]

  @@map("alunos")
}

model Oficina {
  id          String        @id @default(uuid()) @db.Uuid
  nome        String        @db.VarChar(120)
  descricao   String?
  professorId String?       @map("professor_id") @db.Uuid
  dataInicio  DateTime?     @map("data_inicio") @db.Date
  dataFim     DateTime?     @map("data_fim") @db.Date
  vagas       Int           @default(20)
  status      OficinaStatus @default(planejada)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  professor      Profile?       @relation("ProfessorOficinas", fields: [professorId], references: [id])
  oficinaTutores OficinaTutor[]
  aulas          Aula[]
  matriculas     Matricula[]

  @@map("oficinas")
}

model OficinaTutor {
  id        String   @id @default(uuid()) @db.Uuid
  oficinaId String   @map("oficina_id") @db.Uuid
  tutorId   String   @map("tutor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  oficina Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)
  tutor   Profile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([oficinaId, tutorId])
  @@map("oficina_tutores")
}

model Aula {
  id        String   @id @default(uuid()) @db.Uuid
  oficinaId String   @map("oficina_id") @db.Uuid
  data      DateTime @db.Date
  topico    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  oficina   Oficina    @relation(fields: [oficinaId], references: [id], onDelete: Cascade)
  presencas Presenca[]

  @@map("aulas")
}

model Matricula {
  id        String          @id @default(uuid()) @db.Uuid
  alunoId   String          @map("aluno_id") @db.Uuid
  oficinaId String          @map("oficina_id") @db.Uuid
  status    MatriculaStatus @default(ativa)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  aluno     Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  oficina   Oficina    @relation(fields: [oficinaId], references: [id], onDelete: Cascade)
  presencas Presenca[]

  @@unique([alunoId, oficinaId])
  @@map("matriculas")
}

model Presenca {
  id          String   @id @default(uuid()) @db.Uuid
  matriculaId String   @map("matricula_id") @db.Uuid
  aulaId      String   @map("aula_id") @db.Uuid
  presente    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  aula      Aula      @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([matriculaId, aulaId])
  @@map("presencas")
}
